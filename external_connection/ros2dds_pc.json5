{
  plugins: {
    ros2dds: {
      nodename: "zenoh_bridge_ros2dds_pc",
      domain: 44
    }
  },

  mode: "client",

  connect: {
    // NIENTE "endpoints" qui: la lista sta in pick-endpoint.sh, che sonda le
    // interfacce e passa il vincitore con -e. Zenoh non sa scegliere da solo:
    // timeout_ms e' un budget GLOBALE per tutta la lista, non per endpoint, e un
    // endpoint morto costa ~135 s di timeout TCP. Dettagli nel picker.

    // L'endpoint e' gia' stato sondato dal picker, quindi un timeout finito qui
    // e' sicuro: non c'e' nessun buco nero che se lo possa mangiare.
    timeout_ms: { client: 10000 },

    // Se comunque non si connette, esci: Docker rilancia il container
    // ("--restart unless-stopped") e il picker rifa' il probe, passando
    // all'endpoint successivo. E' questo il recupero automatico.
    exit_on_failure: { client: true }
  },

  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false }
  }
}
